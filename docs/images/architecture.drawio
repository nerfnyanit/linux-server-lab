<mxfile host="app.diagrams.net">
  <diagram name="architecture" id="arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- グループ(外側から) -->
        <mxCell id="cloud" value="AWS Cloud" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="860" height="620" as="geometry" />
        </mxCell>
        <mxCell id="region" value="東京リージョン(ap-northeast-1)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="820" height="560" as="geometry" />
        </mxCell>
        <mxCell id="vpc" value="VPC(デフォルト)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="760" height="500" as="geometry" />
        </mxCell>
        <mxCell id="subnet" value="パブリックサブネット" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="160" width="680" height="440" as="geometry" />
        </mxCell>
        <mxCell id="sg" value="セキュリティグループ&lt;br&gt;80 / 443:全体 ・ 22:自宅IPのみ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD3522;fontColor=#DD3522;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="200" width="630" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="EC2 t3.micro / AlmaLinux 9(SELinux Enforcing)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="270" width="580" height="290" as="geometry" />
        </mxCell>

        <!-- AWS のアイコン -->
        <mxCell id="igw" value="Internet&lt;br&gt;Gateway" style="shape=mxgraph.aws4.internet_gateway;fillColor=#8C4FFF;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="256" y="366" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="eip" value="Elastic IP" style="shape=mxgraph.aws4.elastic_ip_address;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="380" y="230" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="budgets" value="Budgets(月 $20 でアラート)・ルートユーザー MFA" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="740" y="44" width="330" height="20" as="geometry" />
        </mxCell>

        <!-- EC2 の中 -->
        <mxCell id="fw" value="&lt;b&gt;firewalld&lt;/b&gt;&lt;br&gt;ssh / http / https" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;443:HTTPS 終端&lt;br&gt;80:301 で HTTPS へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="345" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;Next.js&lt;/b&gt;&lt;br&gt;127.0.0.1:3000&lt;br&gt;systemd で常駐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="345" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="certbot" value="&lt;b&gt;certbot-renew.timer&lt;/b&gt;&lt;br&gt;証明書の自動更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- AWS の外 -->
        <mxCell id="users" value="ユーザー(ブラウザ)" style="shape=mxgraph.aws4.users;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="&lt;b&gt;DuckDNS&lt;/b&gt;&lt;br&gt;nerfnyanit-portfolio&lt;br&gt;.duckdns.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="160" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="le" value="&lt;b&gt;Let's Encrypt&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="470" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dev" value="開発者(手元 PC)" style="shape=mxgraph.aws4.client;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="66" y="720" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;frontend-portfolio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="710" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 線 -->
        <mxCell id="e1" value="名前解決" style="endArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="users" target="dns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="HTTPS(443)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="users" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="igw" target="fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="fw" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="リバースプロキシ&lt;br&gt;(SELinux:&lt;br&gt;httpd_can_network_connect)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="nginx" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="HTTP-01 認証" style="endArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="certbot" target="le">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="SSH 22(鍵認証のみ・自宅 IP から)" style="endArrow=classic;html=1;dashed=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dev" target="fw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="git push" style="endArrow=classic;html=1;dashed=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="dev" target="gh">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="91" y="820" />
              <mxPoint x="890" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="git pull → npm run build" style="endArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="gh" target="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
